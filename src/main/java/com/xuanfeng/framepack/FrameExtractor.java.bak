package com.xuanfeng.framepack;

import org.jcodec.api.FrameGrab;
import org.jcodec.api.JCodecException;
import org.jcodec.common.io.NIOUtils;
import org.jcodec.common.model.Picture;
import org.jcodec.scale.AWTUtil;

import javax.imageio.ImageIO;
import java.awt.Graphics2D;
import java.awt.image.BufferedImage;
import java.io.ByteArrayOutputStream;
import java.io.FileOutputStream;
import java.io.FilterOutputStream;
import java.io.IOException;
import java.io.OutputStream;
import java.nio.file.Path;
import java.util.zip.ZipEntry;
import java.util.zip.ZipOutputStream;

public class FrameExtractor {

    private static final int SAMPLE_WIDTH = 320;
    private static final int SAMPLE_HEIGHT = 180;
    private static final int BLOCKS = 4;

    public static void extract(Path input, Path output, String frameFormat,
                               double threshold, int threads, int throttle)
            throws IOException, JCodecException {

        FrameGrab grab = FrameGrab.createFrameGrab(NIOUtils.readableChannel(input.toFile()));
        int totalFrames = (int) grab.getVideoTrack().getMeta().getTotalFrames();

        CountingOutputStream counter = new CountingOutputStream(new FileOutputStream(output.toFile()));
        ZipOutputStream zip = new ZipOutputStream(counter);

        BufferedImage baseSample = null;
        int index = 0;

        for (int i = 0; i < totalFrames; i++) {
            Picture picture = grab.getNativeFrame();
            if (picture == null) {
                break;
            }
            index++;

            BufferedImage image = AWTUtil.toBufferedImage(picture);

            boolean keep;

            if (threshold <= 0) {
                keep = true;
            } else {
                BufferedImage sample = toSample(image);
                if (baseSample == null) {
                    keep = true;
                } else {
                    double score = difference(baseSample, sample);
                    keep = score > threshold;
                }
                if (keep) {
                    baseSample = sample;
                }
            }

            if (keep) {
                byte[] data = encode(image, frameFormat);
                String name = frameName(index, totalFrames, frameFormat);
                zip.putNextEntry(new ZipEntry(name));
                zip.write(data);
                zip.closeEntry();
            }

            printProgress(index, totalFrames, counter.getCount());

            if (throttle > 0) {
                try {
                    Thread.sleep(throttle);
                } catch (InterruptedException e) {
                    Thread.currentThread().interrupt();
                }
            }
        }

        zip.close();

        System.out.println();
    }

    private static BufferedImage toSample(BufferedImage image) {
        BufferedImage gray = new BufferedImage(SAMPLE_WIDTH, SAMPLE_HEIGHT, BufferedImage.TYPE_BYTE_GRAY);
        Graphics2D g = gray.createGraphics();
        g.drawImage(image, 0, 0, SAMPLE_WIDTH, SAMPLE_HEIGHT, null);
        g.dispose();
        return gray;
    }

    private static double difference(BufferedImage a, BufferedImage b) {
        double global = globalDiff(a, b);
        double block = blockDiff(a, b);
        double hist = histDiff(a, b);
        double edge = edgeDiff(a, b);
        return Math.max(Math.max(global, block), Math.max(hist, edge));
    }

    private static double globalDiff(BufferedImage a, BufferedImage b) {
        long sum = 0;
        int w = a.getWidth();
        int h = a.getHeight();
        for (int y = 0; y < h; y++) {
            for (int x = 0; x < w; x++) {
                int pa = a.getRaster().getSample(x, y, 0);
                int pb = b.getRaster().getSample(x, y, 0);
                sum += Math.abs(pa - pb);
            }
        }
        return (double) sum / (w * h);
    }

    private static double blockDiff(BufferedImage a, BufferedImage b) {
        int w = a.getWidth();
        int h = a.getHeight();
        int bw = w / BLOCKS;
        int bh = h / BLOCKS;
        double max = 0;
        for (int by = 0; by < BLOCKS; by++) {
            for (int bx = 0; bx < BLOCKS; bx++) {
                long sum = 0;
                for (int y = 0; y < bh; y++) {
                    for (int x = 0; x < bw; x++) {
                        int pa = a.getRaster().getSample(bx * bw + x, by * bh + y, 0);
                        int pb = b.getRaster().getSample(bx * bw + x, by * bh + y, 0);
                        sum += Math.abs(pa - pb);
                    }
                }
                double avg = (double) sum / (bw * bh);
                if (avg > max) {
                    max = avg;
                }
            }
        }
        return max;
    }

    private static double histDiff(BufferedImage a, BufferedImage b) {
        int[] ha = histogram(a);
        int[] hb = histogram(b);
        int total = a.getWidth() * a.getHeight();
        long sum = 0;
        for (int i = 0; i < 256; i++) {
            sum += Math.abs(ha[i] - hb[i]);
        }
        return (double) sum / (2 * total) * 255;
    }

    private static int[] histogram(BufferedImage image) {
        int[] hist = new int[256];
        int w = image.getWidth();
        int h = image.getHeight();
        for (int y = 0; y < h; y++) {
            for (int x = 0; x < w; x++) {
                hist[image.getRaster().getSample(x, y, 0)]++;
            }
        }
        return hist;
    }

    private static double edgeDiff(BufferedImage a, BufferedImage b) {
        double sa = edgeSum(a);
        double sb = edgeSum(b);
        return Math.abs(sa - sb);
    }

    private static double edgeSum(BufferedImage image) {
        int w = image.getWidth();
        int h = image.getHeight();
        long sum = 0;
        for (int y = 1; y < h - 1; y++) {
            for (int x = 1; x < w - 1; x++) {
                int c = image.getRaster().getSample(x, y, 0);
                int r = image.getRaster().getSample(x + 1, y, 0);
                int d = image.getRaster().getSample(x, y + 1, 0);
                sum += Math.abs(c - r) + Math.abs(c - d);
            }
        }
        return (double) sum / (w * h);
    }

    private static byte[] encode(BufferedImage image, String format) throws IOException {
        String fmt = format.equals("jpg") ? "jpg" : format;
        BufferedImage out = image;
        if (fmt.equals("jpg")) {
            out = new BufferedImage(image.getWidth(), image.getHeight(), BufferedImage.TYPE_INT_RGB);
            Graphics2D g = out.createGraphics();
            g.drawImage(image, 0, 0, null);
            g.dispose();
        }
        ByteArrayOutputStream buffer = new ByteArrayOutputStream();
        ImageIO.write(out, fmt, buffer);
        return buffer.toByteArray();
    }

    private static String frameName(int index, int totalFrames, String format) {
        int digits = String.valueOf(totalFrames).length();
        if (digits < 1) {
            digits = 1;
        }
        return String.format("%0" + digits + "d." + format, index);
    }

    private static void printProgress(int current, int total, long bytes) {
        double percent = total > 0 ? (double) current / total * 100 : 0;
        String line = PrintOutput.processing() + " " + current + "/" + total
                + " " + String.format("%.2f", percent) + "% "
                + PrintOutput.formatSize(bytes);
        System.out.print("\r" + line + "\033[K");
    }

    static class CountingOutputStream extends FilterOutputStream {
        private long count = 0;

        CountingOutputStream(OutputStream out) {
            super(out);
        }

        @Override
        public void write(int b) throws IOException {
            super.write(b);
            count++;
        }

        @Override
        public void write(byte[] b, int off, int len) throws IOException {
            super.write(b, off, len);
            count += len;
        }

        long getCount() {
            return count;
        }
    }
}
